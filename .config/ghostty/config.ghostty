# ~/.config/ghostty/config.ghostty

# Clipboard: allow remote/tmux OSC 52 writes, but never let programs read it.
clipboard-write = allow
clipboard-read = deny

# Make mouse selection behave like a normal GUI clipboard copy.
copy-on-select = clipboard

# Small visual comfort.
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true

# Less annoying mouse cursor while typing.
# fullscreen = true
mouse-hide-while-typing = true

# Optional: pick a theme after browsing them.
# Run: ghostty +list-themes
theme = TokyoNight Moon

shell-integration-features = ssh-terminfo,ssh-env,sudo
